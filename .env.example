# Supabase Auth
NUXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_REEMPLAZAR
NUXT_SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR

# PostgreSQL de Supabase.
# DATABASE_URL: Supavisor en modo transacción (6543) para Vercel/serverless.
# pgbouncer=true evita prepared statements; el pool se limita en server/utils/prisma.ts.
# DIRECT_URL: Supavisor en modo sesión (5432) para migraciones ejecutadas fuera de Vercel.
DATABASE_URL=postgresql://prisma.TU_PROYECTO:CONTRASENA@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://prisma.TU_PROYECTO:CONTRASENA@REGION.pooler.supabase.com:5432/postgres

# Opcional. Si no existe ningún perfil, el primer usuario autenticado se
# convierte en administrador general. Este correo restringe ese arranque.
BOOTSTRAP_ADMIN_EMAIL=
