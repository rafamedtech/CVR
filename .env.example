# Aplicación
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth
NUXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_REEMPLAZAR
NUXT_SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR

# PostgreSQL de Supabase.
# DATABASE_URL: Supavisor (sesión en puerto 5432 para servidor persistente).
# DIRECT_URL: conexión directa para migraciones cuando esté disponible.
DATABASE_URL=postgresql://prisma.TU_PROYECTO:CONTRASENA@REGION.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://prisma:CONTRASENA@db.TU_PROYECTO.supabase.co:5432/postgres

# URL usada en invitaciones y recuperación de contraseña
NUXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/confirm

# Opcional. Si no existe ningún perfil, el primer usuario autenticado se
# convierte en administrador general. Este correo restringe ese arranque.
BOOTSTRAP_ADMIN_EMAIL=
