generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkshopType {
  BODY_SHOP
  MECHANICAL
  PAINT_STORE
}

enum WorkshopRole {
  MANAGER
  ADVISOR
  TECHNICIAN
  CASHIER
}

enum OrderStatus {
  ESTIMATE
  AWAITING_APPROVAL
  APPROVED
  IN_PROGRESS
  QUALITY_CONTROL
  READY
  DELIVERED
  CANCELLED
}

enum OrderPriority {
  NORMAL
  HIGH
  URGENT
}

enum LineItemType {
  SERVICE
  PART
  LABOR
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHECK
  CREDIT
  OTHER
}

enum PaymentStatus {
  NO_PAYMENTS
  PARTIALLY_PAID
  PAID
}

enum Currency {
  MXN
  USD
}

enum ExpenseCategory {
  RENT
  PAYROLL
  UTILITIES
  SUPPLIES
  MAINTENANCE
  MARKETING
  TAXES
  OTHER
}

model Workshop {
  id        String             @id @default(uuid()) @db.Uuid
  slug      String             @unique
  name      String
  type      WorkshopType
  active    Boolean            @default(true)
  currency  String             @default("MXN")
  taxRate   Decimal            @default(16) @db.Decimal(5, 2)
  timezone  String             @default("America/Tijuana")
  phone     String?
  address   String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  members   WorkshopMember[]
  customers CustomerWorkshop[]
  vehicles  VehicleWorkshop[]
  orders    ServiceOrder[]
  expenses  Expense[]

  @@map("workshops")
}

model Profile {
  id               String           @id @db.Uuid
  email            String           @unique
  fullName         String
  phone            String?
  isSuperAdmin     Boolean          @default(false)
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  memberships      WorkshopMember[]
  createdOrders    ServiceOrder[]   @relation("CreatedOrders")
  assignedOrders   ServiceOrder[]   @relation("AssignedOrders")
  recordedPayments Payment[]
  recordedExpenses Expense[]

  @@map("profiles")
}

model WorkshopMember {
  profileId  String       @db.Uuid
  workshopId String       @db.Uuid
  role       WorkshopRole
  createdAt  DateTime     @default(now())
  profile    Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  workshop   Workshop     @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@id([profileId, workshopId])
  @@index([workshopId, role])
  @@map("workshop_members")
}

model Customer {
  id                    String             @id @default(uuid()) @db.Uuid
  fullName              String
  phone                 String
  alternatePhone        String?
  email                 String?
  taxId                 String?
  addressLine           String?            @map("address")
  addressInteriorNumber String?
  addressExteriorNumber String?
  addressColony         String?
  addressLocality       String?
  addressCountryCode    String?
  addressStateCode      String?
  addressCityCode       String?
  addressPostalCode     String?
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  workshops             CustomerWorkshop[]
  vehicles              Vehicle[]
  orders                ServiceOrder[]

  @@index([fullName])
  @@index([phone])
  @@map("customers")
}

model CustomerWorkshop {
  customerId String   @db.Uuid
  workshopId String   @db.Uuid
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@id([customerId, workshopId])
  @@index([workshopId, createdAt])
  @@map("customer_workshops")
}

model Vehicle {
  id           String            @id @default(uuid()) @db.Uuid
  customerId   String            @db.Uuid
  vin          String?           @unique
  licensePlate String?           @unique
  make         String
  model        String
  year         Int
  color        String?
  mileage      Int?
  fuelLevel    Int?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  workshops    VehicleWorkshop[]
  orders       ServiceOrder[]

  @@index([customerId])
  @@map("vehicles")
}

model VehicleWorkshop {
  vehicleId  String   @db.Uuid
  workshopId String   @db.Uuid
  createdAt  DateTime @default(now())
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@id([vehicleId, workshopId])
  @@index([workshopId, createdAt])
  @@map("vehicle_workshops")
}

model ServiceOrder {
  id              String        @id @default(uuid()) @db.Uuid
  workshopId      String        @db.Uuid
  customerId      String        @db.Uuid
  vehicleId       String        @db.Uuid
  orderNumber     String
  status          OrderStatus   @default(ESTIMATE)
  paymentStatus   PaymentStatus @default(NO_PAYMENTS)
  priority        OrderPriority @default(NORMAL)
  requiresInvoice Boolean       @default(false)
  complaint       String
  diagnosis       String?
  intakeNotes     String?
  internalNotes   String?
  mileageIn       Int?
  fuelLevelIn     Int?
  promisedAt      DateTime?
  approvedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  deliveredAt     DateTime?
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  createdById     String        @db.Uuid
  assignedToId    String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  workshop        Workshop      @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdBy       Profile       @relation("CreatedOrders", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo      Profile?      @relation("AssignedOrders", fields: [assignedToId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]

  @@unique([workshopId, orderNumber])
  @@index([workshopId, status, createdAt])
  @@index([customerId])
  @@index([vehicleId])
  @@index([assignedToId])
  @@map("service_orders")
}

model OrderItem {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  type        LineItemType
  description String
  currency    Currency     @default(MXN)
  exchangeRate Decimal     @default(1) @db.Decimal(12, 6)
  quantity    Decimal      @default(1) @db.Decimal(10, 2)
  unitCost    Decimal      @default(0) @db.Decimal(12, 2)
  unitPrice   Decimal      @db.Decimal(12, 2)
  discount    Decimal      @default(0) @db.Decimal(12, 2)
  taxRate     Decimal      @default(16) @db.Decimal(5, 2)
  subtotal    Decimal      @db.Decimal(12, 2)
  taxTotal    Decimal      @db.Decimal(12, 2)
  total       Decimal      @db.Decimal(12, 2)
  totalCost   Decimal      @db.Decimal(12, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, type])
  @@map("order_items")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  orderId      String        @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  amountMxn    Decimal       @db.Decimal(12, 2)
  currency     Currency      @default(MXN)
  exchangeRate Decimal       @default(1) @db.Decimal(12, 6)
  method       PaymentMethod
  reference    String?
  notes        String?
  paidAt       DateTime      @default(now())
  recordedById String        @db.Uuid
  createdAt    DateTime      @default(now())
  order        ServiceOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordedBy   Profile       @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([orderId, paidAt])
  @@map("payments")
}

model Expense {
  id           String          @id @default(uuid()) @db.Uuid
  workshopId   String          @db.Uuid
  category     ExpenseCategory
  description  String
  vendor       String?
  amount       Decimal         @db.Decimal(12, 2)
  expenseDate  DateTime        @default(now())
  notes        String?
  recordedById String          @db.Uuid
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  workshop     Workshop        @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  recordedBy   Profile         @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([workshopId, expenseDate])
  @@map("expenses")
}
